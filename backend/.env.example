# Existing shell variables take precedence. Keep your real keys in backend/.env.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=your-ollama-key

# Required: create an account at https://e2b.dev/ and get an API key.
E2B_API_KEY=your-e2b-key
E2B_TEMPLATE=pydantic-ai-chat-python312
# Used when building the template. Rebuild after changing the image.
E2B_BASE_IMAGE=python:3.12-slim

SANDBOX_IDLE_TIMEOUT_SECONDS=600
# Keep within your E2B account's sandbox lifetime limit.
SANDBOX_MAX_LIFETIME_SECONDS=3600
CHAT_TIMEOUT_SECONDS=180
